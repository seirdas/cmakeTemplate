
struct HelloWorld {
    long id;
    string message;
};

@annotation BreakerId 
{
	uint16 value;
};

@annotation BreakerPanelId
{
	uint8 value;
};


module CABINA_IDL
{
	@topic
	@BreakerPanelId(0x01)
	struct st_CircuitBreakersSystems1
	{
		@BreakerId(0x0101) boolean bkrTrimARTCU;
		@BreakerId(0x0102) boolean bkrTrimAil;	
		@BreakerId(0x0103) boolean bkrTrimStbyRud;		 	 
	};

	@topic
	struct st_BreakerChangeEvent
	{
		uint16 id;
		uint8 panelId;
		boolean breakerValue;
	};

	bitset bt_AvionicsSwitchesIn
	{
		bitfield<1> swMHF;	
		bitfield<1> swVUHF;	
	};

	@topic
	struct st_AvionicsSwitchesIn
	{
		bt_AvionicsSwitchesIn data;
	};

	// SYSTEM TEST/RESET CONTROL PANEL (OVERHEAD)
	bitset bt_SystemTestResetIn
	{
		bitfield<1> pbSWRSTest;			
		bitfield<1> pbGMeterReset;		
		bitfield<1> pbLdgGrTest;				
	};

	bitset bt_SystemTestResetOut
	{
		bitfield<1> ltSMKDetTest;
		bitfield<1> ltBUBatTest1;
		bitfield<1> ltBUBatTest2;
	};

	@topic
	struct st_SystemTestResetIn
	{
		bt_SystemTestResetIn data;
	};
}