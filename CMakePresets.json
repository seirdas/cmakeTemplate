            "configuration": "Debug",
            "hidden": false
        },
        {
            "name": "clang64",
            "configurePreset": "clang64",
            "jobs": 4,
            "environment": {
                "PATH": "$env{CLANG_PATH}/bin;$env{NINJA_PATH}/bin;$penv{PATH}"
            },
            "description": "Plantilla oculta para heredar configuraciones comunes",
            "hidden": true
        },
        {
            "name": "clang64-release",
            "targets": [ "all" ],
            "displayName": "🔷 Clang64 (Release)",
            "configurePreset": "clang64-release",
            "inherits": "clang64",
            "configuration": "Release",
            "hidden": false
        },
        {
            "name": "clang64-debug",
            "targets": [ "all" ],
            "displayName": "🔷 Clang64 (Debug)",
            "configurePreset": "clang64-debug",
            "inherits": "clang64",
            "configuration": "Debug",
            "hidden": false
        },
        {
            "name": "clang64-ninja-release",
            "displayName": "🚀 Clang Release (x64)",
            "description": "Build en Release para Clang (x64).",
            "configurePreset": "clang64-ninja",
            "configuration": "Release",
            "hidden": false
        },
        {
            "name": "clang64-ninja-debug",
            "displayName": "🐞 Clang Debug (x64)",
            "description": "Build en Debug para Clang (x64).",
            "configurePreset": "clang64-ninja",
            "configuration": "Debug",
            "hidden": false
        },
        {
            "name": "clang64-ninja-relwithdebinfo",
            "displayName": "🔍 Clang RelWithDebInfo (x64)",
            "description": "Build en RelWithDebInfo para Clang (x64).",
            "configurePreset": "clang64-ninja",
            "configuration": "RelWithDebInfo",
            "hidden": false
        },


        {
            "name": "vs2019-release",
            "displayName": "🚀 VS2019 Release (x64)",
            "description": "Build en Release para Visual Studio 2019 (x64).",
            "configurePreset": "vs2019",
            "configuration": "Release"
        },
        {
            "name": "vs2019-debug",
            "displayName": "🐞 VS2019 Debug (x64)",
            "description": "Build en Debug para Visual Studio 2019 (x64).",
            "configurePreset": "vs2019",
            "configuration": "Debug"
        },
        {
