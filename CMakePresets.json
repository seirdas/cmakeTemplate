{
    "version": 3,
    "configurePresets": [
        {
            "name": "vs2019",
            "displayName": "🔴 Visual Studio 2019 (x64)",
            "description": "Genera solución .sln para Visual Studio 2019 (x64).",
            "generator": "Visual Studio 16 2019",
            "binaryDir": "${sourceDir}/_build/vs2019",
            "architecture": "x64"
        },
        {
            "name": "vs2022",
            "displayName": "🟢 Visual Studio 2022 (x64)",
            "description": "Genera solución .sln para Visual Studio 2022 (x64).",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/_build/vs2022",
            "architecture": "x64"
        },
        {
            "name": "vs2026",
            "displayName": "🟣 Visual Studio 2026 (x64)",
            "description": "Genera solución .sln para Visual Studio 2026 (x64).",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/_build/vs2026",
            "architecture": "x64"
        },
        {
            "name": "mingw64",
            "description": "Plantilla oculta para heredar las opciones comunes de mingw64",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "toolchainFile": "${sourceDir}/toolchains/mingw-mingw64.cmake",
            "cacheVariables": {
                "MINGW_PATH":"$env{MINGW_PATH}"
            },
            "environment": {
                "MINGW_PATH": "C:/msys64/mingw64"
            },
            "hidden": true
        },
        {
            "name": "mingw64-ninja",
            "displayName": "🟠 Ninja MinGW-x64",
            "description": "Genera Makefiles de MinGW-w64. Necesita tener instalado Ninja.",
            "generator": "Ninja Multi-Config",
            "inherits": "mingw64",
            "environment": {
                "NINJA_PATH":"${sourceDir}/other"
            },
            "hidden": false
        },
        {
            "name": "mingw64-release",
            "displayName": "🔶 MinGW-x64 Release",
            "generator": "MinGW Makefiles",
            "description": "Genera Makefiles de MinGW-w64 en Release. Revisar MINGW_PATH en preset.",
            "inherits": "mingw64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release"
            },
            "hidden": false
        },
        {
            "name": "mingw64-debug",
            "displayName": "🔶 MinGW-x64 Debug",
            "generator": "MinGW Makefiles",
            "description": "Genera Makefiles de MinGW-w64 en Debug. Revisar MINGW_PATH en preset.",
            "inherits": "mingw64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug"
            },
            "hidden": false
        },
        {
            "name": "clang64",
            "description": "Plantilla oculta para heredar las opciones comunes de mingw64",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "toolchainFile": "${sourceDir}/toolchains/mingw-clang64.cmake",
            "cacheVariables": {
                "CLANG_PATH":"$env{CLANG_PATH}"
            },
            "environment": {
                "CLANG_PATH": "C:/msys64/clang64"
            },
            "hidden": true
        },
        {
            "name": "clang64-ninja",
            "displayName": "🔵 Clang-x64 Ninja",
            "generator": "Ninja Multi-Config",
            "description": "Genera Makefiles para Clang. Necesita tener instalado Ninja.",
            "inherits": "clang64",
            "environment": {
                "NINJA_PATH":"${sourceDir}/other"
            },
            "hidden": false
        },
        {
            "name": "clang64-release",
            "displayName": "🔷 Clang-x64 Release",
            "generator": "MinGW Makefiles",
            "description": "Genera Makefiles para Clang en Release. Revisar CLANG_PATH en preset.",
            "inherits": "clang64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release"
            },
            "hidden": false
        },
        {
            "name": "clang64-debug",
            "displayName": "🔷 Clang-x64 Debug",
            "generator": "MinGW Makefiles",
            "description": "Genera Makefiles para Clang en Debug. Revisar CLANG_PATH en preset.",
            "inherits": "clang64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug"
            },
            "hidden": false
        }
    ],
    "buildPresets": [
        {
            "name": "mingw64",
            "environment": {
                "PATH": "C:/msys64/mingw64/bin;C:/Users/Sergio/Desktop/cmavi/other;$penv{PATH}"
            },
            "cleanFirst": false,
            "jobs": 4,
            "description": "Plantilla oculta para heredar configuraciones comunes",
            "hidden": true
        },
        {
            "name": "mingw64-release",
            "targets": [ "all" ],
            "displayName": "🔶 Mingw64 (Release)",
            "configurePreset": "mingw64-release",
            "inherits": "mingw64",
            "configuration": "Release",
            "hidden":false
        },
        {
            "name": "mingw64-debug",
            "targets": [ "all" ],
            "displayName": "🔶 Mingw64 (Debug)",
            "configurePreset": "mingw64-debug",
            "inherits": "mingw64",
            "configuration": "Debug",
            "hidden": false
        },
        {
            "name": "mingw64-ninja-release",
            "displayName": "🚀 Mingw64 Release (x64)",
            "description": "Build en Release para Mingw64 (x64).",
            "configurePreset": "mingw64-ninja",
            "configuration": "Release",
            "hidden": false
        },
        {
            "name": "mingw64-ninja-debug",
